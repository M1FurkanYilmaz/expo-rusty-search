{
  "name": "expo-rusty-search",
  "version": "0.1.0",
  "description": "An expo library that makes fast string searches with Rust core",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android",
    "build:android": "tsx scripts/cargo-android.ts",
    "build:ios": "tsx scripts/cargo-ios.ts",
    "build:ios:device": "tsx scripts/cargo-ios.ts -- --target=ios",
    "build:clean": "cd expo-search-core && cargo clean"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-rusty-search",
    "ExpoRustySearch"
  ],
  "repository": "https://github.com/M1FurkanYilmaz/expo-rusty-search",
  "bugs": {
    "url": "https://github.com/M1FurkanYilmaz/expo-rusty-search/issues"
  },
  "author": "Fumedeme <1M.FurkanYilmaz@gmail.com> (https://github.com/M1FurkanYilmaz)",
  "license": "MIT",
  "homepage": "https://github.com/M1FurkanYilmaz/expo-rusty-search#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/react": "~19.1.0",
    "expo": "^54.0.27",
    "expo-module-scripts": "^5.0.8",
    "react-native": "0.81.5",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
